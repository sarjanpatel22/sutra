# Non-secret config only. Secrets go in OS keyring (python-keyring).
# Copy to .env and fill in. Never commit .env.

# Claude API
ANTHROPIC_API_KEY=your_key_here

# Groq (free tier fallback)
GROQ_API_KEY=your_key_here

# Google Gemini (free tier fallback)
GEMINI_API_KEY=your_key_here

# SearXNG (self-hosted)
SEARXNG_URL=http://localhost:8080

# --- Memory layer (Phase 1.3) ---
# FalkorDB is a Redis-protocol server, so it owns 6379; session Redis uses 6380.
# Ports match docker-compose.yml — keep them in sync.

# FalkorDB (Graphiti graph memory backend)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379

# Redis (session + tool state) — host 6380 to avoid clashing with FalkorDB
REDIS_URL=redis://localhost:6380

# Qdrant — DROPPED (see docs/SUTRA_PHASES.md): memory vectors are computed in-process
# from nomic-embed-text, no separate vector store. Kept only for the optional
# `sutra health` check; safe to remove.
QDRANT_URL=http://localhost:6333

# Memory behaviour
MEMORY_ENABLED=1               # 0 to disable graph memory entirely
MEMORY_GROUP_ID=sarjan         # namespace; one per user
USER_NAME=Sarjan               # who Sutra is talking to; recalled "<name> is …" facts resolve to "you"

# Graphiti entity-extraction LLM + embeddings (free local defaults via Ollama).
# qwen2.5:14b: extracts relationships cleanly (gemma3:4b drops them, qwen2.5:7b
# leaks Chinese). Needs ~9GB VRAM on demand. For sharper still / lower VRAM, point
# at Groq: base_url=https://api.groq.com/openai/v1, model=llama-3.3-70b-versatile,
# and set GRAPHITI_LLM_API_KEY to your free Groq key.
GRAPHITI_LLM_BASE_URL=http://localhost:11434/v1
GRAPHITI_LLM_MODEL=qwen2.5:14b
GRAPHITI_LLM_API_KEY=ollama    # dummy value is fine for local Ollama
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768

# Recall ranking: the prefixed-nomic index is always on; an LLM reranker (free Groq)
# can sharpen its top-N → top-k (hit@1 80→100% on the eval probes) for ~300-500ms/call.
# OFF by default for latency; the memory graph GUI uses it regardless of this flag.
RECALL_RERANK=0
# RECALL_RERANK_MODEL=groq/llama-3.3-70b-versatile
# RECALL_RERANK_TOPN=12          # candidates pulled by cosine before the rerank pass
# RECALL_INDEX_TTL=180           # seconds before the cached fact embeddings rebuild

# Routing thresholds
ROUTER_LOCAL_MODEL=ollama/gemma3:4b    # fast local voice/chat model (no tools — gemma can't)
# Local FUNCTION-CALLING fallback: when every free cloud model is rate-limited, tool
# turns fall here so Sutra still ACTS offline (gemma can't take tools; qwen2.5 can).
ROUTER_LOCAL_TOOLS_MODEL=ollama_chat/qwen2.5:7b
ROUTER_REASON_MODEL=ollama_chat/gemma4:e4b  # local REASONING model (thinking on) — `sutra think`
# Free Groq vision model behind guide_me / sutra watch / desktop take-over / Telegram
# photos. Single source of truth — change here if Groq retires it (it retired
# llama-4-maverick; scout is current, verified 2026-06-15).
GROQ_VISION_MODEL=groq/meta-llama/llama-4-scout-17b-16e-instruct
ROUTER_CLOUD_DEFAULT=claude-haiku-4-5  # Default council model
ROUTER_CLOUD_HEAVY=claude-sonnet-4-6   # Heavy reasoning
ROUTER_CLOUD_MAX=claude-opus-4-8       # Hardest tasks only
# Allow the paid Claude tiers at all. OFF = the $0 guarantee (free local/Groq/Gemini
# only); even on a rate-limited tool turn the router will NOT escalate to Claude unless
# this is 1 (and a working ANTHROPIC_API_KEY is set).
ROUTER_ALLOW_PAID=0

# --- Agent autonomy ---
# Hands-free voice: when 1, voice may run normally-GATED skills (run_command,
# act_on_screen / type_into, file writes) WITHOUT a spoken confirmation. OFF by default
# — only the browse/navigate family runs hands-free. run_command keeps its
# catastrophic-command floor even when this is on. Sarjan's explicit opt-in.
SUTRA_AUTONOMOUS=0

# Auto-convene the multi-agent council on multi-faceted "research AND design AND draft"
# turns (architect decomposes → specialists fan out in parallel → review → synthesize).
# OFF by default — `sutra council "<goal>"` and the council tool work regardless; this
# flag only lets the brain pick the council automatically on its own.
SUTRA_COUNCIL_AUTO=0

# Model tier the autonomous loop (`sutra auto` / `sutra pwn`) reasons on:
# medium = free 70B, heavy = Claude Sonnet 4.6, max = Claude Opus 4.8 for hard boxes.
# heavy/max need ROUTER_ALLOW_PAID=1; override per-run with `--tier`.
SUTRA_AUTO_TIER=heavy

# Budget
MONTHLY_BUDGET_USD=30
DAILY_BUDGET_USD=2
BUDGET_ALERT_THRESHOLD=0.85   # alert when spend hits 85% of limit
MONITOR_INTERVAL_S=300        # watchdog check interval (seconds)

# Audio devices (run `sutra devices` to list options)
AUDIO_INPUT_DEVICE=pulse      # pulse resamples 16kHz; a BLANK value re-triggers the raw-ALSA -9997 crash
AUDIO_OUTPUT_DEVICE=pulse     # pulse = PipeWire/PulseAudio (recommended)

# Voice model settings
WHISPER_MODEL=distil-large-v3  # STT model: small.en ~75ms (fumbles names), distil-large-v3 ~330ms (balanced), large-v3 ~440ms (most accurate)
WHISPER_DEVICE=auto           # auto, cuda, cpu
WHISPER_LANGUAGE=en           # fix language to skip Whisper's per-call detection (blank = auto-detect)
WHISPER_BEAM=1                # 1 = greedy (fastest, ~30% quicker); raise to 5 for hardest audio
STT_MIN_LOGPROB=-1.0          # don't persist voice turns below this Whisper avg_logprob (far-field hallucinations); lower = more permissive
STT_MAX_NOSPEECH=0.6          # don't persist turns whose no_speech_prob exceeds this (likely no real speech)
VOICE_STREAMING_STT=0         # 1 = transcribe during the end-of-turn silence wait (STT off the critical path; small win — STT is already fast)
KOKORO_VOICE=bm_george        # Sutra's voice. 54 options: af_*/am_* (US f/m), bf_*/bm_* (UK f/m), e.g. af_heart, am_michael, bf_emma
KOKORO_SPEED=1.0              # speech rate multiplier
ONNX_PROVIDER=CUDAExecutionProvider  # GPU TTS (confirmed working)
VAD_THRESHOLD=0.5             # Silero VAD speech-probability cutoff (0–1); lower = more sensitive
VAD_SILENCE_S=0.5            # end-of-turn silence wait (s); biggest latency knob — lower = snappier, risks cutting pauses

# Barge-in (sutra voice --mode vad): stop speaking when you talk over her.
# OFF by default — on OPEN SPEAKERS Sutra hears her own TTS and self-interrupts
# (no echo canceller). Reliable on a HEADSET / close mic; set =1 there. For open
# speakers, either keep =0 or set up PipeWire `module-echo-cancel` and point
# AUDIO_INPUT_DEVICE at the cancelled source.
VOICE_BARGE_IN=0              # 1 = enable barge-in (VAD mode only)
VOICE_BARGE_THRESHOLD=0.7    # speech-prob to count as an interruption (>VAD_THRESHOLD on purpose: echo gives weak prob)
VOICE_BARGE_RMS_FLOOR=500    # min frame loudness (int16 RMS) — gates out attenuated speaker echo
VOICE_BARGE_GRACE_S=0.25     # ignore the mic this long after playback starts (lets output settle)
VOICE_BARGE_SUSTAIN_S=0.2    # required continuous speech before cutting — rejects transient echo blips

# Wake word (sutra voice --mode wake): sit dormant until a wake word, then one turn.
# openWakeWord on the existing onnxruntime (no torch); pretrained models ship bundled.
WAKEWORD_ENABLED=0           # 1 = enable (or just use --mode wake)
WAKEWORD_MODEL=hey_jarvis    # bundled: hey_jarvis, alexa, hey_mycroft, hey_marvin, timer, weather (custom "Hey Sutra" = a training follow-on)
WAKEWORD_THRESHOLD=0.5       # 0-1 wake-model probability to fire; raise to cut false wakes
WAKEWORD_COOLDOWN_S=2.0      # min seconds between wakes (one spoken word = one turn)
WAKEWORD_TRIGGER_FRAMES=1    # consecutive over-threshold frames required (raise to harden vs blips)

# Ambient OS-memory daemon (sutra ambient)
AMBIENT_ENABLED=1             # 0 to disable ambient capture entirely
AMBIENT_SOURCES=window,files,git,shell  # which signals to capture
# AMBIENT_WATCH_DIRS=/home/you/projects:/home/you/Documents  # colon-separated; defaults to friday-os/projects/Documents
AMBIENT_POLL_S=5             # how often to sample (seconds)
AMBIENT_FLUSH_S=1200         # how often to write captured activity to memory (seconds)
AMBIENT_IDLE_S=120           # idle gap that ends a work session (seconds)

# --- Ambient watch (sutra watch) ---
# Always-on glance-over-your-shoulder loop. OFF by default — only runs when you
# start `sutra watch`. Screenshots go to the free Groq vision model ONLY when the
# screen changes and the cooldown has elapsed; silent unless a suggestion helps.
WATCH_POLL_S=20              # seconds between ticks
WATCH_COOLDOWN_S=90          # minimum seconds between two surfaced suggestions
WATCH_CHANGE_THRESHOLD=8     # ahash hamming distance that counts as a screen "change"
WATCH_DAILY_CAP=40           # max suggestions per day (resets at local midnight)
WATCH_SPEAK=0                # 1 = also speak the suggestion aloud via spd-say
# WATCH_VISION_MODEL=groq/meta-llama/llama-4-scout-17b-16e-instruct  # free Groq vision model id

# --- Telegram bridge (sutra telegram) ---
# Preferred: store in OS keyring via `python -m keyring set sutra TELEGRAM_BOT_TOKEN <token>`
# Fallback: set the env var below. Get a token from @BotFather on Telegram.
# TELEGRAM_BOT_TOKEN=your_bot_token_here

# Comma-separated Telegram chat IDs allowed to use the bot. Find your chat_id by
# messaging @userinfobot on Telegram. If unset, the bot operates single-user (a warning
# is logged). Strongly recommended to set this.
# TELEGRAM_ALLOWED_CHAT_IDS=123456789
