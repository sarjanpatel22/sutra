# Non-secret config only. Secrets go in OS keyring (python-keyring).
# Copy to .env and fill in. Never commit .env.

# Claude API
ANTHROPIC_API_KEY=your_key_here

# Groq (free tier fallback)
GROQ_API_KEY=your_key_here

# Google Gemini (free tier fallback)
GEMINI_API_KEY=your_key_here

# SearXNG (self-hosted)
SEARXNG_URL=http://localhost:8080

# --- Memory layer (Phase 1.3) ---
# FalkorDB is a Redis-protocol server, so it owns 6379; session Redis uses 6380.
# Ports match docker-compose.yml — keep them in sync.

# FalkorDB (Graphiti graph memory backend)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379

# Redis (session + tool state) — host 6380 to avoid clashing with FalkorDB
REDIS_URL=redis://localhost:6380

# Qdrant (vector memory)
QDRANT_URL=http://localhost:6333

# Memory behaviour
MEMORY_ENABLED=1               # 0 to disable graph memory entirely
MEMORY_GROUP_ID=sarjan         # namespace; one per user
USER_NAME=Sarjan               # who Sutra is talking to; recalled "<name> is …" facts resolve to "you"

# Graphiti entity-extraction LLM + embeddings (free local defaults via Ollama).
# qwen2.5:14b: extracts relationships cleanly (gemma3:4b drops them, qwen2.5:7b
# leaks Chinese). Needs ~9GB VRAM on demand. For sharper still / lower VRAM, point
# at Groq: base_url=https://api.groq.com/openai/v1, model=llama-3.3-70b-versatile,
# and set GRAPHITI_LLM_API_KEY to your free Groq key.
GRAPHITI_LLM_BASE_URL=http://localhost:11434/v1
GRAPHITI_LLM_MODEL=qwen2.5:14b
GRAPHITI_LLM_API_KEY=ollama    # dummy value is fine for local Ollama
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768

# Routing thresholds
ROUTER_LOCAL_MODEL=ollama/gemma3:4b    # Ollama model name for local router
ROUTER_CLOUD_DEFAULT=claude-haiku-4-5  # Default council model
ROUTER_CLOUD_HEAVY=claude-sonnet-4-6   # Heavy reasoning
ROUTER_CLOUD_MAX=claude-opus-4-8       # Hardest tasks only

# Budget
MONTHLY_BUDGET_USD=30
DAILY_BUDGET_USD=2
BUDGET_ALERT_THRESHOLD=0.85   # alert when spend hits 85% of limit
MONITOR_INTERVAL_S=300        # watchdog check interval (seconds)

# Audio devices (run `sutra devices` to list options)
AUDIO_INPUT_DEVICE=pulse      # pulse resamples 16kHz; a BLANK value re-triggers the raw-ALSA -9997 crash
AUDIO_OUTPUT_DEVICE=pulse     # pulse = PipeWire/PulseAudio (recommended)

# Voice model settings
WHISPER_MODEL=small.en        # ~75ms STT, same quality on clear speech; use large-v3 for noisy/multilingual
WHISPER_DEVICE=auto           # auto, cuda, cpu
KOKORO_VOICE=af_heart         # Kokoro voice ID
ONNX_PROVIDER=CUDAExecutionProvider  # GPU TTS (confirmed working)
