# Non-secret config only. Secrets go in OS keyring (python-keyring).
# Copy to .env and fill in. Never commit .env.

# Claude API
ANTHROPIC_API_KEY=your_key_here

# Groq (free tier fallback)
GROQ_API_KEY=your_key_here

# Google Gemini (free tier fallback)
GEMINI_API_KEY=your_key_here

# SearXNG (self-hosted)
SEARXNG_URL=http://localhost:8080

# Redis
REDIS_URL=redis://localhost:6379

# FalkorDB
FALKORDB_HOST=localhost
FALKORDB_PORT=6379

# Qdrant
QDRANT_URL=http://localhost:6333

# Routing thresholds
ROUTER_LOCAL_MODEL=gemma2:4b           # Ollama model name for local router
ROUTER_CLOUD_DEFAULT=claude-haiku-4-5  # Default council model
ROUTER_CLOUD_HEAVY=claude-sonnet-4-6   # Heavy reasoning
ROUTER_CLOUD_MAX=claude-opus-4-8       # Hardest tasks only

# Budget
MONTHLY_BUDGET_USD=30
DAILY_BUDGET_USD=2
